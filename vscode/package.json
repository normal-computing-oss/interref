{
  "name": "nref",
  "displayName": "nref",
  "description": "Follow, preview and check nref cross-file references in comments",
  "version": "0.1.0",
  "publisher": "normal-computing",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nref.copyRef",
        "title": "Copy ref",
        "category": "nref"
      },
      {
        "command": "nref.showGraph",
        "title": "Show ref graph",
        "category": "nref",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nref.refresh",
        "title": "Refresh file index",
        "category": "nref"
      },
      {
        "command": "nref.revealDirectory",
        "title": "Reveal directory",
        "category": "nref"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "nref.copyRef",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@9"
        },
        {
          "command": "nref.showGraph",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@10"
        }
      ],
      "explorer/context": [
        {
          "command": "nref.copyRef",
          "group": "6_copypath@9"
        },
        {
          "command": "nref.showGraph",
          "group": "6_copypath@10"
        }
      ],
      "commandPalette": [
        {
          "command": "nref.revealDirectory",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "nref",
      "properties": {
        "nref.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Underline broken refs in open files."
        },
        "nref.hover.lines": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Lines of the target to show when you hover over a ref."
        },
        "nref.graph.viewer": {
          "type": "string",
          "enum": [
            "drawio",
            "mermaid"
          ],
          "enumDescriptions": [
            "Open the graph in the Draw.io Integration extension (hediet.vscode-drawio).",
            "Open the graph in the official Mermaid extension (MermaidChart.vscode-mermaid-chart), or else in Mermaid Preview (vstirbu.vscode-mermaid-preview)."
          ],
          "default": "drawio",
          "description": "The extension that shows \"nref: Show ref graph\". It must be installed; the command offers to install it."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository --out nref.vsix"
  },
  "devDependencies": {
    "@nref/core": "0.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
