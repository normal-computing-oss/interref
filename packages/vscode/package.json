{
  "name": "vscode-interref",
  "displayName": "interref",
  "description": "Follow, preview, check and graph iref: cross-file links in comments",
  "version": "0.3.0",
  "publisher": "normal-computing",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/normal-computing-oss/interref.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "interref.copyRef",
        "title": "Copy ref",
        "category": "interref"
      },
      {
        "command": "interref.showGraph",
        "title": "Show ref graph",
        "category": "interref",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "interref.refresh",
        "title": "Refresh file index",
        "category": "interref"
      },
      {
        "command": "interref.revealDirectory",
        "title": "Reveal directory",
        "category": "interref"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "interref.copyRef",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@9"
        },
        {
          "command": "interref.showGraph",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@10"
        }
      ],
      "explorer/context": [
        {
          "command": "interref.copyRef",
          "group": "6_copypath@9"
        },
        {
          "command": "interref.showGraph",
          "group": "6_copypath@10"
        }
      ],
      "commandPalette": [
        {
          "command": "interref.revealDirectory",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "interref",
      "properties": {
        "interref.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Underline broken refs in open files."
        },
        "interref.hover.lines": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Lines of the target to show when you hover over a ref."
        },
        "interref.graph.viewer": {
          "type": "string",
          "enum": [
            "drawio",
            "mermaid"
          ],
          "enumDescriptions": [
            "Open the graph in the Draw.io Integration extension (hediet.vscode-drawio).",
            "Open the graph in the official Mermaid extension (MermaidChart.vscode-mermaid-chart), or else in Mermaid Preview (vstirbu.vscode-mermaid-preview)."
          ],
          "default": "drawio",
          "description": "The extension that shows \"interref: Show ref graph\". It must be installed; the command offers to install it."
        }
      }
    }
  },
  "scripts": {
    "bundle": "node esbuild.mjs",
    "package": "cp ../../LICENSE . && vsce package --no-dependencies --out interref.vsix"
  },
  "devDependencies": {
    "@interref/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "catalog:"
  }
}
