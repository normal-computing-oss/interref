  "keywords": [
    "links",
    "references",
    "comments",
    "documentation",
    "lint"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/normal-computing-oss/interref.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/normal-computing-oss/interref#readme",
  "bugs": "https://github.com/normal-computing-oss/interref/issues",
  "type": "module",
  "bin": {
    "interref": "./dist/interref.mjs",
    "iref": "./dist/interref.mjs"
