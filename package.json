{
  "name": "interref-workspace",
  "private": true,
  "description": "interref: a CLI and a VS Code extension for iref: cross-file links in comments",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsrs -b && pnpm -r bundle",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "pnpm build && pnpm -r test",
    "check": "pnpm lint && pnpm test",
    "package": "pnpm build && pnpm --filter vscode-interref package",
    "clean": "tsrs -b --clean && rm -rf packages/*/dist packages/vscode/*.vsix",
    "release": "node scripts/release.mjs",
    "verify-comments": "pnpm build && node scripts/verify-comments.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "shiki": "^4.5.0",
    "tsrs": "0.20.0-ts7.1.0-beta"
  }
}
